// Code Reading Layout
// Left 60%: Neovim for reading code
// Right 40%: AI explanations pane

layout {
    tab name="Code Reading" {
        pane split_direction="vertical" {
            pane size="60%" {
                command "nvim"
            }
            pane size="40%" name="AI Explanations" {
                command "fish"
            }
        }
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
}
