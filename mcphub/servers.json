{
  "mcpServers": {
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant"
      ],
      "env": {},
      "autoApprove": [
        "goto_definition",
        "find_references",
        "get_symbols",
        "search_symbols",
        "get_diagnostics",
        "get_hover",
        "get_signature_help"
      ]
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home",
        "/tmp"
      ],
      "env": {},
      "autoApprove": [
        "read_file",
        "list_directory",
        "get_file_info",
        "search_files"
      ]
    },
    "git": {
      "command": "uvx",
      "args": [
        "mcp-server-git",
        "--repository",
        "."
      ],
      "env": {},
      "autoApprove": [
        "git_log",
        "git_diff",
        "git_status",
        "git_show",
        "git_diff_staged"
      ]
    }
  }
}
